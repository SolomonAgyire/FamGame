{
  // Worker name — this becomes part of your free *.workers.dev address
  // (e.g. wordin.<your-subdomain>.workers.dev) unless you attach a
  // custom domain later. Renaming this moves the live URL -- the old
  // gatherword.sagyire83.workers.dev address stops working once this
  // version is deployed to production.
  "name": "wordin",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],

  // Serve on the free *.workers.dev address (https://wordin.<subdomain>.workers.dev).
  // Explicit here just to silence Wrangler's "using default" warnings.
  "workers_dev": true,
  "preview_urls": true,

  // Cloudflare account to deploy to. Left unset on purpose so it's not
  // committed to a public repo — set it locally with `wrangler login`
  // (interactive) or via the CLOUDFLARE_ACCOUNT_ID env var / GitHub Actions
  // secret (CI). See docs/superpowers/specs/... deployment notes.
  // "account_id": "<your-account-id>",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gatherword-db",
      "database_id": "80f4799c-e14b-46a2-af83-f9bdd93d676d"
    }
  ]
}
