{
  // Worker name — this becomes part of your free *.workers.dev address
  // (e.g. gatherword.<your-subdomain>.workers.dev) unless you attach a
  // custom domain later.
  "name": "gatherword",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],

  // Cloudflare account to deploy to. Left unset on purpose so it's not
  // committed to a public repo — set it locally with `wrangler login`
  // (interactive) or via the CLOUDFLARE_ACCOUNT_ID env var / GitHub Actions
  // secret (CI). See docs/superpowers/specs/... deployment notes.
  // "account_id": "<your-account-id>",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gatherword-db",
      // Placeholder — replace with the real ID printed by:
      //   npx wrangler d1 create gatherword-db
      // Local dev works with this placeholder (Miniflare simulates D1
      // locally); only real deploys need the real ID here.
      "database_id": "00000000-0000-4000-8000-000000000000"
    }
  ]
}
